#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -d "$SCRIPT_DIR/.venv" ] && command -v uv >/dev/null 2>&1; then
    exec uv run --project "$SCRIPT_DIR" "$SCRIPT_DIR/later.py" "$@"
else
    if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
        exec "$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/later.py" "$@"
    else
        exec "${PYTHON:-python}" "$SCRIPT_DIR/later.py" "$@"
    fi
fi
